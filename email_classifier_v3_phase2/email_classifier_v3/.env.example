# Copy this file to `.env` and adjust as needed.
# None of these are required for default local development —
# sensible defaults are baked into app/core/config.py — but they
# let you override paths/ports without touching code.

# Path to the OAuth client secrets file from Google Cloud Console.
# Default: <project_root>/credentials.json
GOOGLE_CREDENTIALS_FILE=credentials.json

# Path where the user's OAuth token gets cached after login.
# Default: <project_root>/token.json
GOOGLE_TOKEN_FILE=token.json

# Must exactly match a redirect URI registered on the OAuth client
# in Google Cloud Console.
OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

APP_HOST=0.0.0.0
APP_PORT=8000

# Gmail search query used by /emails/fetch
GMAIL_FETCH_QUERY=is:unread newer_than:1d
GMAIL_FETCH_MAX_RESULTS=25
